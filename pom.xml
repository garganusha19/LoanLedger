<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===== Project Identity ===== -->
    <groupId>com.loanledger</groupId>
    <artifactId>loanledger</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LoanLedger</name>
    <description>A console-based loan management system for small lending businesses.</description>

    <!-- ===== Java Version ===== -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ===== Dependencies ===== -->
    <dependencies>

        <!--
            MySQL Connector/J
            Provides the JDBC driver that lets Java connect to a MySQL database.
            Without this, java.sql.Connection cannot communicate with MySQL.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!--
            JUnit Jupiter (JUnit 5)
            The testing framework used to write and run unit tests.
            scope=test means it is NOT included in the production build.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===== Build Plugins ===== -->
    <build>
        <plugins>

            <!--
                Maven Compiler Plugin
                Tells Maven to compile all Java source files using Java 21.
                The 'release' flag ensures both source and target are Java 21.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                Maven Surefire Plugin
                Discovers and runs JUnit 5 tests during the "test" phase.
                Version 3.x is required for JUnit 5 (Jupiter) support.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <!--
                Exec Maven Plugin
                Allows running the application's main class from the terminal:
                .\mvnw.cmd exec:java -Dexec.mainClass=com.loanledger.Main
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <mainClass>com.loanledger.Main</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>

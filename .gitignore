# ============================================================
# LoanLedger — .gitignore
# ============================================================

# ----- Maven build output -----
target/
*.jar
*.war
*.ear
*.nar

# ----- Maven Wrapper downloaded cache (do NOT commit the cache) -----
.mvn/wrapper/maven-wrapper.jar

# ----- Java compiled files -----
*.class

# ----- Logs -----
*.log
logs/

# ----- Database credentials — NEVER commit real credentials -----
src/main/resources/application.properties

# Keep the template so others know what properties exist
!src/main/resources/application.properties.template

# ----- IntelliJ IDEA -----
.idea/
*.iml
*.iws
*.ipr
out/

# ----- Eclipse -----
.classpath
.project
.settings/
bin/

# ----- VS Code -----
.vscode/

# ----- NetBeans -----
nbproject/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ----- macOS -----
.DS_Store
*.DS_Store

# ----- Windows -----
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- JVM crash logs -----
hs_err_pid*
replay_pid*
